{
  "section": "lmr-alignment-safety-release",
  "addedResources": [],
  "units": [
    {
      "id": "behavior-specification-threat-model",
      "title": "Behavioral specifications, policy boundaries and threat models",
      "hours": 4,
      "target": [
        "explain"
      ],
      "topics": [
        "specification-and-policy",
        "threat-model"
      ],
      "outcomes": [
        "Separate intended behavior, observed compliance and unresolved policy choices.",
        "Map an LLM application's assets, actors, access, trust boundaries and residual consequences to testable claims.",
        "Specify expected behavior for benign, ambiguous and disallowed requests before labeling outputs."
      ],
      "why": "Build on Security goals, trust boundaries and threat models. Here the new job is to connect a model behavior to a plausible harm and a measurable policy boundary, not just draw the system.",
      "next": [
        {
          "unit": "llm-research/lmr-alignment-safety-release/harmful-compliance-overrefusal",
          "note": "Measure both sides of the policy boundary."
        }
      ],
      "study": [
        {
          "resource": "model-spec-lmr10",
          "title": "OpenAI Model Spec, 2026-08-18: one worked behavior contract",
          "url": "https://model-spec.openai.com/2026-08-18.html",
          "locator": "Instructions and levels of authority; The chain of command, especially Follow all applicable instructions and Ignore untrusted data by default; Protect people's privacy",
          "depth": "Read these sections and their examples only. Treat the vendor's choices as an example, not a universal policy or evidence of compliance."
        },
        {
          "resource": "arena-safety-lmr10",
          "title": "ARENA 3.1: Threat-Modeling & Specification Design",
          "url": "https://learn.arena.education/chapter3_llm_evals/01_intro_evals/3-threat-modeling-specification-design/",
          "locator": "What are evals trying to achieve?; Threat-Modeling; Specification; Question Design",
          "depth": "Work by hand. Skip hosted API calls and the alignment-faking replication."
        },
        {
          "resource": "nist-genai-profile-lmr10",
          "title": "NIST AI 600-1: policy and threat-model ownership",
          "url": "https://doi.org/10.6028/NIST.AI.600-1",
          "locator": "Section 3, GOVERN 3.2: GV-3.2-003 (acceptable use and refusal criteria) and GV-3.2-005 (threat modeling)"
        }
      ],
      "focus": [
        "Write the deployment scope first: a local assistant with offline documents and no real credentials or external actions. Name who can edit user messages, retrieved text and tool results.",
        "Give every test a policy clause, expected behavior, severity and rationale. Clarification and safe assistance are distinct from refusal.",
        "Connect each threat to an asset, attacker capability, entry point, mitigation, detection signal and residual consequence. Record assumptions the experiment cannot test.",
        "Freeze the specification before labels. Keep disputed normative cases visible rather than relabeling them to match a benchmark."
      ],
      "reproduce": "Closed-book, trace a fake instruction in a retrieved document through an offline assistant to an unauthorized disclosure of a synthetic secret. Mark the authority boundary, then write one benign request, one ambiguous request and one disallowed request with expected behavior and the policy clause that decides each.",
      "traps": [
        "Calling a specification an empirical safety result. It states what should happen; the campaign measures what actually happens.",
        "Treating a model's stated intentions or multiple-choice answer as proof of its motives. Measure behavior under a stated protocol instead.",
        "Letting the benchmark silently define policy. Its labels may disagree with your intended application."
      ],
      "selfTest": [
        {
          "q": "A retrieved page says it is a system message. Does that grant it authority?",
          "a": "No. Its provenance remains untrusted retrieved data. A textual claim of authority does not change the message's trust boundary."
        },
        {
          "q": "Why keep ambiguous requests in the specification?",
          "a": "They test clarification and context-sensitive assistance. A binary refuse-or-comply policy can hide both unsafe completions and unnecessary refusals."
        },
        {
          "q": "A test passes, but its assumed tool permission is absent in the application. What follows?",
          "a": "The result describes that test configuration, not the proposed harm pathway. Reconcile the access assumption before using it in the safety argument."
        }
      ],
      "practice": [
        {
          "name": "ARENA 3.1: Build threat models; Design a specification",
          "url": "https://learn.arena.education/chapter3_llm_evals/01_intro_evals/3-threat-modeling-specification-design/",
          "locator": "Exercises Build threat models and Design a specification",
          "note": "Adapt one property to your offline assistant. Write the causal scenario and operational definitions by hand; no paid API is needed. Keep the assumptions and unresolved choices for the campaign."
        }
      ],
      "stopWhen": "Your written scope and policy decide the three boundary cases, and every modeled threat ends in a testable claim or an owned evidence gap.",
      "fit": {
        "verdict": "kept",
        "note": "The dated Model Spec, ARENA design exercises and NIST actions cover the policy, threat and ownership job without a new resource."
      }
    },
