{
  "section": "capacity-economics-engine-extension",
  "addedResources": [],
  "units": [
    {
      "id": "benchmark-question-manifest",
      "title": "The benchmark question, its decision owner and an immutable manifest",
      "hours": 4,
      "target": [
        "explain",
        "implement"
      ],
      "topics": [
        "benchmark-question-and-decision-owner",
        "immutable-model-engine-hardware-and-workload-manifest",
        "tuning-traces-versus-final-traces"
      ],
      "outcomes": [
        "Turn a serving benchmark into a decision with an owner, two alternatives and a reversal condition.",
        "Extend your experiment manifest to bind request semantics, quality, failures and cost to each result.",
        "Separate tuning traffic from a frozen final evaluation corpus before selecting configurations."
      ],
      "why": "Build on Manifests, claim schemas, predictions declared first and artifact lineage. The new contract must support a serving decision, not just reproduce a device timing.",
      "next": [
        {
          "unit": "inference/capacity-economics-engine-extension/load-goodput-useful-work",
          "note": "Choose counters that answer the declared decision."
        }
      ],
      "study": [
        {
          "resource": "hands-serving-ch9-inf9",
          "title": "The optimization plan before the benchmark",
          "url": "https://www.oreilly.com/library/view/hands-on-llm-serving/9798341621480/",
          "locator": "Chapter 9, LLM Serving Optimization Plan, printed pp. 294 to 296; Step 2: Generate Benchmark Traffic, pp. 297 to 300",
          "depth": "Read the workflow, not the hardware setup commands. Replace the worked model and deployment with a small model that fits your GPU; keep distributed variants as reading."
        },
        {
          "resource": "inference-lab-inf9",
          "title": "Bind experiments to their serving contract",
          "url": "https://github.com/saisandeshk/Roadmap-Final/blob/main/projects/capstones/llm-inference-systems-laboratory.md#architecture-constraints",
          "locator": "Core requirements: recorded workload corpus; Architecture constraints: versions, tuning versus final traces and hardware tier; Milestone C: hypothesis and reversal conditions"
        }
      ],
      "focus": [
        "Name the decision owner and the action the evidence can change: retain the baseline, enable the contribution or add capacity. Set correctness and SLO gates before tuning.",
        "Bind model, tokenizer, template, adapter, weight and KV precision, engine revision, effective configuration, hardware state and workload hashes to the run.",
        "Retain intended arrival times, output limits, stop rules, tenant scope, deadlines, retry policy and quality evaluator. A prompt list alone is not a workload.",
        "Split by sessions or shared-prefix groups where leakage is possible. Freeze final traces and transformations before configuration selection."
      ],
      "reproduce": "Without notes, write a decision record and manifest for your existing `servelab` baseline. Give each tuning and final corpus a digest. Change the output stop rule in a second record and verify that the workload identity changes rather than silently reusing the first result.",
      "traps": [
        "A package version does not identify a locally patched engine. Record the source revision and patch digest too.",
        "Selecting a configuration after inspecting final traces turns them into tuning data. Acquire a new final set before making a generalization claim.",
        "Calling synthetic prefix repetition representative of demand. It isolates reuse; it does not supply production arrival or length distributions."
      ],
      "selfTest": [
        {
          "q": "What makes a benchmark question actionable?",
          "a": "An owner, a choice between alternatives, fixed correctness and SLO constraints, and an observation that would reverse the choice."
        },
        {
          "q": "Why is freezing prompts insufficient?",
          "a": "Tokenization, arrivals, output lengths, stopping, cache state, retries and evaluation can change the work even when prompt text stays fixed."
        },
        {
          "q": "May the final workload use the same length distribution as tuning?",
          "a": "Yes. The distributions can match, but final requests or sessions must not have been used to select the configuration. Record any intended distribution shift separately."
        }
      ],
      "practice": [],
      "practiceNote": "The section mini-project covers this: the `servelab` decision record, immutable experiment manifests and separate tuning and final traces.",
      "stopWhen": "Your decision record names two alternatives and a reversal condition, and a changed request contract cannot reuse an old manifest identity.",
      "fit": {
        "verdict": "kept",
        "note": "The Chapter 9 workflow and capstone constraints cover governance and corpus separation; the mini-project supplies manifest implementation."
      }
    },
